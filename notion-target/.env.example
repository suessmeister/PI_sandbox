MODEL_PROVIDER=openai
MODEL_NAME=gpt-4.1
OPENAI_API_KEY=
# OpenRouter must support the Responses API, vision and tool calls for this model.
OPENROUTER_API_KEY=
NOTION_TOKEN=
SENSITIVE_PAGE_ID=
SENSITIVE_PAGE_TITLE=Key Info
SYSTEM_PROMPT_FILE=system_prompt.txt
# Optional inline SYSTEM_PROMPT takes precedence over the file.
# SYSTEM_PROMPT=
MCP_COMMAND=node
MCP_ARGS=["node_modules/@notionhq/notion-mcp-server/bin/cli.mjs"]
MAX_TOOL_STEPS=24
REQUEST_TIMEOUT_SECONDS=120
TRACE_DIR=traces
